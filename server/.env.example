# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_project_management?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/smart_project_management
MONGODB_URI=mongodb://127.0.0.1:27017/smart_project_management

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production

# Client Application URL (For CORS validation)
CLIENT_URL=http://localhost:3000
