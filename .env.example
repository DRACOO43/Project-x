# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server Port
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_project_management?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/smart_project_management"

# JWT Secret Key
JWT_SECRET="smart_pm_production_jwt_secret_key_2026_change_in_production"

# Frontend API URL
VITE_API_URL="/api"
